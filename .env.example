NEXT_PUBLIC_APP_NAME="BotHosting"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_PASSWORD_HASH=""

PTERODACTYL_PANEL_URL="https://panel.example.com"
# Client key for listing and power-managing bot servers (minimum client permissions)
PTERODACTYL_CLIENT_API_KEY="ptlc_replace_me"
# Application key is privileged: only the server-side admin provisioning API uses it. Never expose it.
PTERODACTYL_APPLICATION_API_KEY="ptla_replace_me"
# Panel user ID who owns provisioned servers; should match the Client API key owner.
PTERODACTYL_DEFAULT_USER_ID="1"
# Comma-separated short identifiers, or * ONLY when using a dedicated Client API account for this app.
PTERODACTYL_ALLOWED_SERVER_IDS="*"
BOT_HOSTING_API_TOKEN=""
