NEXT_PUBLIC_APP_NAME="BotHosting"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate a random secret with: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Set this to output from: npm run auth:hash -- "your-long-admin-password"
ADMIN_PASSWORD_HASH=""

# Pterodactyl Client API key from the account that owns the bot servers (never NEXT_PUBLIC_)
PTERODACTYL_PANEL_URL="https://panel.example.com"
PTERODACTYL_CLIENT_API_KEY="ptlc_replace_me"
# Comma-separated short identifiers for servers this dashboard may manage
PTERODACTYL_ALLOWED_SERVER_IDS=""

# Optional bearer for legacy machine-to-machine integration endpoints
BOT_HOSTING_API_TOKEN=""
